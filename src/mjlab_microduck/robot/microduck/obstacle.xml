<mujoco model="microduck_obstacle">
    <compiler angle="radian" autolimits="true"/>

    <worldbody>
        <!-- First curriculum obstacle: 100 x 200 x 100 mm, with its 200 mm
             width across the robot's path. It is intentionally free-moving
             but heavy enough that avoiding it is cheaper than pushing it. -->
        <body name="obstacle" pos="0.8 0 0.05">
            <freejoint name="obstacle_free"/>
            <geom type="box" name="obstacle_geom" size="0.05 0.10 0.05"
                  mass="2.0" rgba="0.85 0.20 0.15 1" friction="0.8 0.01 0.001"/>
        </body>
    </worldbody>
</mujoco>
